# Gemini 
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_IMAGE_MODEL_NAME=gemini-2.5-flash-image
LLM_TIMEOUT_SECONDS=45

# Pinecone / retrieval
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-ai-assistant
PINECONE_NAMESPACE=enterprise
USE_PINECONE=false

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-ai-assistant

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=120

# RAG
HYBRID_DENSE_WEIGHT=0.65
HYBRID_SPARSE_WEIGHT=0.35
RETRIEVAL_TOP_K=6

# RLM safeguards
MAX_RECURSION_DEPTH=3
MAX_RESEARCH_SUBTASKS=6
MAX_DOCUMENTS_PER_STEP=8
MAX_TOTAL_TOKENS=12000

# Rate limiting
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=0.2
